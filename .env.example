# ---- Server ----
PORT=4000
NODE_ENV=development
SERVICE_NAME=music-service

# ---- Mongo ----
MONGO_URI=mongodb://localhost:27017/spotify_music

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- RabbitMQ ----
RABBITMQ_URL=amqp://localhost:5672

# ---- Auth (verifies tokens issued by the external Auth Service) ----
JWT_PUBLIC_KEY_OR_SECRET=replace-with-shared-secret-or-public-key
JWT_ALGORITHM=HS256

# ---- Cloudflare R2 ----
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET=spotify-music
R2_PUBLIC_BASE_URL=https://cdn.spotify.example.com

# ---- External services (existing microservices) ----
AUTH_SERVICE_BASE_URL=http://auth-service:5001
USER_SERVICE_BASE_URL=http://user-service:5002
PAYMENT_SERVICE_BASE_URL=http://payment-service:5003
NOTIFICATION_SERVICE_BASE_URL=http://notification-service:5004

# ---- Media / upload limits ----
MAX_UPLOAD_SIZE_BYTES=209715200
MAX_AUDIO_DURATION_SEC=1800
PRESIGNED_UPLOAD_TTL_SEC=900
PLAYBACK_URL_TTL_SEC=300
PLAYBACK_HEARTBEAT_SEC=10
REDIS_PLAYBACK_TTL_SEC=604800

# ---- Rate limit ----
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX_DEFAULT=120
RATE_LIMIT_MAX_PLAYBACK=30
RATE_LIMIT_MAX_UPLOAD=10

# ---- Circuit breaker ----
CIRCUIT_BREAKER_TIMEOUT_MS=3000
CIRCUIT_BREAKER_ERROR_THRESHOLD=50
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=15000

# ---- Free tier ----
FREE_TIER_DAILY_PLAY_LIMIT=3
