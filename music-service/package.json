{
  "name": "music-service",
  "version": "1.0.0",
  "description": "Music service phase 1: catalog, media, playback, queue, library, playlist, search, analytics, admin, and sharing.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "worker:dev": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "aws-sdk": "^2.1600.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "opossum": "^8.1.4",
    "pino": "^9.1.0",
    "pino-http": "^10.1.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.8",
    "redis": "^4.7.0",
    "axios": "^1.7.9",
    "amqp-connection-manager": "^4.3.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.2",
    "@types/opossum": "^8.1.8",
    "@types/uuid": "^9.0.8",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
